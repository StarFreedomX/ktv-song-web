{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "lib",
        "target": "esnext",
        "module": "esnext",
        "declaration": true,
        "composite": true,
        "incremental": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@satorijs/element",
        "types": [
            "jest",
            "node"
        ],
        "baseUrl": "src",
        "paths": {
            "@/*": [
                "*"
            ]
        }
    },
    "include": [
        "src"
    ]
}

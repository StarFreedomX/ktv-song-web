{
    "name": "ktv-song-web",
    "description": "KTV Song List Web",
    "contributors": [
        "StarFreedomX <starfreedomx@outlook.com>"
    ],
    "version": "0.4.1",
    "license": "MIT",
    "keywords": ["ktv"],
    "author": "",
    "packageManager": "pnpm@10.20.0",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "dev:backend": "pnpm --filter ./backend dev",
        "dev:frontend": "pnpm --filter ./frontend dev",
        "start": "pnpm -r --parallel start",
        "start:backend": "pnpm --filter ./backend start",
        "start:frontend": "pnpm --filter ./frontend start",
        "build": "pnpm -r --parallel build",
        "build:backend": "pnpm --filter ./backend build",
        "build:frontend": "pnpm --filter ./frontend build",
        "docker-build": "docker-compose up -d --build --force-recreate --remove-orphans",
        "docker-build-proxy": "cross-env HTTP_PROXY=http://172.19.160.1:7890 HTTPS_PROXY=http://172.19.160.1:7890 docker-compose up -d --build --force-recreate --remove-orphans"
    },
    "devDependencies": {
        "cross-env": "^10.1.0"
    }
}
